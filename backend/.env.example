# ── OpenAI API ──────────────────────────────────────────
OPENAI_API_KEY=sk-proj-your-key-here
OPENAI_MODEL=gpt-4o-mini

# ── MySQL DB ─────────────────────────────────────────────
MYSQL_DATABASE=cgi_25K_DA3_p3_1
MYSQL_USER=cgi_25K_DA3_p3_1
MYSQL_PASSWORD=your-db-password
MYSQL_HOST=project-db-campus.smhrd.com
MYSQL_PORT=3307

# ── AI 서버 (컨테이너 환경에서는 자동 주입됨) ──────────────
# docker-compose: AI_SERVER_URL=http://ai_server:8000 (environment에서 주입)
# 로컬 개발: AI_SERVER_URL=http://localhost:8000
AI_SERVER_URL=http://localhost:8000

# ── 백엔드 포트 ──────────────────────────────────────────────
PORT=3001

# ── JWT ──────────────────────────────────────────────────────
JWT_SECRET=change-this-to-a-strong-random-secret

# ── Frontend URL (CORS 허용 주소) ──────────────────────────
# 배포 시: 서버 공개 IP 또는 도메인
FRONTEND_URL=http://localhost:3000

# ── 카카오 디벨로퍼 ────────────────────────────────────
KAKAO_REST_API_KEY=your-kakao-rest-api-key
KAKAO_CLIENT_SECRET=your-kakao-client-secret
# 배포 시 NCP 공인IP/도메인으로 변경 필요
KAKAO_REDIRECT_URI=http://YOUR_SERVER_IP/api/auth/kakao/callback

# ── 구글 로그인 ─────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
# 배포 시 NCP 공인IP/도메인으로 변경 필요
GOOGLE_REDIRECT_URI=http://YOUR_SERVER_IP/api/auth/google/callback

# ── 네이버 로그인 ─────────────────────────────────────────
NAVER_CLIENT_ID=your-naver-client-id
NAVER_CLIENT_SECRET=your-naver-client-secret
# 배포 시 NCP 공인IP/도메인으로 변경 필요
NAVER_REDIRECT_URI=http://YOUR_SERVER_IP/api/auth/naver/callback
