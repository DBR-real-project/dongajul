# ── OpenAI API ──────────────────────────────────────────
OPENAI_API_KEY=sk-proj-여기에_API키_입력
OPENAI_MODEL=gpt-4o-mini   # gpt-4o 로 바꾸면 더 정확하지만 비용 증가

# ── MySQL DB ─────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=rootpass
MYSQL_DATABASE=dongajul
MYSQL_USER=dongajul
MYSQL_PASSWORD=dongajul1234
MYSQL_HOST=db          # Docker Compose 내부에서는 서비스명
MYSQL_PORT=3306

